# cpu-monitor.ps1 - Alerte mail si la charge CPU dépasse un seuil (Windows 11)

$Seuil        = 85          # % de CPU déclenchant l'alerte
$Intervalle   = 30          # secondes entre deux mesures
$Cooldown     = 900         # secondes minimum entre deux mails (anti-spam)

$SmtpServer   = "smtp.gmail.com"
$SmtpPort     = 587
$Utilisateur  = "myMail@gmail.com"
$MotDePasse   = "password"
$Destinataire = "myMail@gmail.com"

function Get-CpuUsage {
    $mesures = 1..3 | ForEach-Object {
        (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average
        Start-Sleep -Seconds 1
    }
    [math]::Round(($mesures | Measure-Object -Average).Average, 1)
}

function Send-Alert($cpu) {
    $secure = ConvertTo-SecureString $MotDePasse -AsPlainText -Force
    $cred   = New-Object System.Management.Automation.PSCredential($Utilisateur, $secure)
    Send-MailMessage -From $Utilisateur -To $Destinataire `
        -Subject "ALERTE CPU sur $($env:COMPUTERNAME) : $cpu %" `
        -Body "La charge CPU est de $cpu % (seuil : $Seuil %) le $(Get-Date)." `
        -SmtpServer $SmtpServer -Port $SmtpPort -UseSsl -Credential $cred `
        -WarningAction SilentlyContinue
}

$dernierMail = [datetime]::MinValue

while ($true) {
    $cpu = Get-CpuUsage
    Write-Host "$(Get-Date -Format 'HH:mm:ss') CPU : $cpu %"

    if ($cpu -gt $Seuil -and ((Get-Date) - $dernierMail).TotalSeconds -gt $Cooldown) {
        try {
            Send-Alert $cpu
            $dernierMail = Get-Date
            Write-Host "Mail d'alerte envoyé."
        } catch {
            Write-Warning "Échec de l'envoi : $_"
        }
    }
    Start-Sleep -Seconds $Intervalle
}